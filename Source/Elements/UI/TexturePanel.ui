<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TexturePanel</class>
 <!-- Panneau « Textures » (LOT-42). Conçu en SECTIONS dès ce lot : LOT-44 (Fond), LOT-45 (Objets),
      LOT-47 (Animations) et LOT-50 (Décors) y ajouteront la leur en insérant un onglet, sans
      toucher aux existantes ni au câblage de MainWindow.
      Les libellés posés ici sont des repères pour Qt Designer : retranslateUi les remplace tous
      par le catalogue de traduction (EX-REN-033). -->
 <widget class="QWidget" name="TexturePanel">
  <layout class="QVBoxLayout" name="rootLayout">
   <item>
    <layout class="QHBoxLayout" name="setLayout">
     <item>
      <widget class="QLabel" name="setLabel">
       <property name="text"><string>Jeu de skins</string></property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="setSelector"/>
     </item>
     <item>
      <widget class="QPushButton" name="reloadButton">
       <property name="text"><string>Recharger</string></property>
       <property name="toolTip"><string>Recharge les textures depuis le disque</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QTabWidget" name="sections">
     <property name="currentIndex"><number>0</number></property>
     <widget class="QWidget" name="skinsTab">
      <attribute name="title"><string>Skins</string></attribute>
      <layout class="QVBoxLayout" name="skinsLayout">
       <item>
        <widget class="QTreeView" name="skinsTree">
         <property name="rootIsDecorated"><bool>true</bool></property>
         <property name="alternatingRowColors"><bool>true</bool></property>
         <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
        </widget>
       </item>
      </layout>
     </widget>
     <!-- Section « Fond » (LOT-44) : propriétés DU NIVEAU courant (fond + jeu de skins), pas une
          configuration globale, distincte du sélecteur « Jeu de skins » ci-dessus (session
          d'édition courante). S'ajoute sans toucher à l'onglet Skins ni au câblage de MainWindow,
          exactement comme prévu par la structure en onglets du LOT-42. -->
     <widget class="QWidget" name="backgroundTab">
      <attribute name="title"><string>Fond</string></attribute>
      <layout class="QVBoxLayout" name="backgroundLayout">
       <item>
        <widget class="QLabel" name="backgroundModeHintLabel">
         <property name="text">
          <string>Le rendu du fond nécessite le mode Texture (F8).</string>
         </property>
         <property name="wordWrap"><bool>true</bool></property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="levelSkinSetLayout">
         <item>
          <widget class="QLabel" name="levelSkinSetLabel">
           <property name="text"><string>Jeu de skins du niveau</string></property>
          </widget>
         </item>
         <item>
          <widget class="QComboBox" name="levelSkinSetSelector"/>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="backgroundLabel">
         <property name="text"><string>Fond</string></property>
        </widget>
       </item>
       <item>
        <widget class="QWidget" name="backgroundContainer">
         <layout class="QVBoxLayout" name="backgroundContainerLayout">
          <property name="leftMargin"><number>0</number></property>
          <property name="topMargin"><number>0</number></property>
          <property name="rightMargin"><number>0</number></property>
          <property name="bottomMargin"><number>0</number></property>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
     <!-- Section « Objets » (LOT-45) : texture par instance, prioritaire sur le skin du type
          (EX-EDIT-043). Meme patron de section embarquee que « Fond » ci-dessus, sans panneau
          separe. -->
     <widget class="QWidget" name="objectsTab">
      <attribute name="title"><string>Objets</string></attribute>
      <layout class="QVBoxLayout" name="objectsLayout">
       <item>
        <widget class="QLabel" name="objectsAssetLabel">
         <property name="text"><string>Asset a assigner</string></property>
        </widget>
       </item>
       <item>
        <widget class="QWidget" name="objectPickerContainer">
         <layout class="QVBoxLayout" name="objectPickerContainerLayout">
          <property name="leftMargin"><number>0</number></property>
          <property name="topMargin"><number>0</number></property>
          <property name="rightMargin"><number>0</number></property>
          <property name="bottomMargin"><number>0</number></property>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="objectsListLabel">
         <property name="text"><string>Surcharges du niveau</string></property>
        </widget>
       </item>
       <item>
        <widget class="QTableView" name="objectsTable">
         <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
         <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
         <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="objectsRemoveButton">
         <property name="text"><string>Retirer</string></property>
         <property name="enabled"><bool>false</bool></property>
        </widget>
       </item>
      </layout>
     </widget>
     <!-- Section « Animations » (LOT-47) : asset anime par defaut de chaque famille de mecanisme
          a etat (porte, interrupteur, plaque, dangers commute/temporise/mobile), stocke comme un
          skin de type ordinaire (meme catalogue, meme jeu courant), avec en plus le diagnostic
          des clips manquants et un apercu de lecture. Meme patron de section embarquee que
          « Fond »/« Objets » ci-dessus. -->
     <widget class="QWidget" name="animationsTab">
      <attribute name="title"><string>Animations</string></attribute>
      <layout class="QVBoxLayout" name="animationsLayout">
       <item>
        <widget class="QTreeView" name="animationsTree">
         <property name="rootIsDecorated"><bool>false</bool></property>
         <property name="alternatingRowColors"><bool>true</bool></property>
         <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
         <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="animationPreviewLayout">
         <item>
          <widget class="QLabel" name="animationPreviewCaption">
           <property name="text"><string>Apercu</string></property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="animationPreviewLabel">
           <property name="minimumSize"><size><width>64</width><height>64</height></size></property>
           <property name="maximumSize"><size><width>64</width><height>64</height></size></property>
           <property name="frameShape"><enum>QFrame::Box</enum></property>
           <property name="alignment"><set>Qt::AlignCenter</set></property>
          </widget>
         </item>
         <item>
          <spacer name="animationPreviewSpacer">
           <property name="orientation"><enum>Qt::Horizontal</enum></property>
          </spacer>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
     <!-- Section « Décors » (LOT-50 TACHE-04) : liste des décors du niveau, groupés par couche et
          dans l'ordre de superposition (hmi::buildDecorListRows), avec sélection croisée avec le
          canevas et actions de réordonnancement/changement de couche/suppression/centrage. -->
     <widget class="QWidget" name="decorsTab">
      <attribute name="title"><string>Décors</string></attribute>
      <layout class="QVBoxLayout" name="decorsLayout">
       <item>
        <widget class="QTableView" name="decorsTable">
         <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
         <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
         <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="decorsActionsLayout">
         <item>
          <widget class="QPushButton" name="decorForwardButton">
           <property name="text"><string>Avancer</string></property>
           <property name="enabled"><bool>false</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="decorBackwardButton">
           <property name="text"><string>Reculer</string></property>
           <property name="enabled"><bool>false</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QComboBox" name="decorLayerCombo">
           <property name="enabled"><bool>false</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="decorCenterButton">
           <property name="text"><string>Centrer</string></property>
           <property name="enabled"><bool>false</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="decorRemoveButton">
           <property name="text"><string>Supprimer</string></property>
           <property name="enabled"><bool>false</bool></property>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
