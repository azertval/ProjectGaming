<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PlanesPanel</class>
 <!-- Panneau « Plans » (LOT-69 TACHE-08, EX-EDIT-047) : liste ordonnée des plans picturaux du
      niveau, et réglages du plan sélectionné.
      La liste est ORDONNÉE et son ordre est significatif : c'est lui qui décide de la
      superposition à l'intérieur d'une profondeur. D'où les boutons Monter/Descendre plutôt qu'un
      tri de colonne, qui laisserait croire que l'ordre est un confort d'affichage.
      Les libellés posés ici sont des repères pour Qt Designer : retranslateUi les remplace tous
      (EX-REN-033). -->
 <widget class="QWidget" name="PlanesPanel">
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QTreeWidget" name="planeTree">
     <property name="rootIsDecorated"><bool>false</bool></property>
     <property name="uniformRowHeights"><bool>true</bool></property>
     <property name="alternatingRowColors"><bool>true</bool></property>
     <column><property name="text"><string>Fichier</string></property></column>
     <column><property name="text"><string>Densité</string></property></column>
     <column><property name="text"><string>Profondeur</string></property></column>
     <column><property name="text"><string>Visible</string></property></column>
    </widget>
   </item>
   <!-- Cycle de vie et ordre : deux gestes distincts, deux rangées distinctes. -->
   <item>
    <layout class="QHBoxLayout" name="lifecycleLayout">
     <item>
      <widget class="QPushButton" name="addButton">
       <property name="text"><string>Ajouter</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="removeButton">
       <property name="text"><string>Supprimer</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="paintButton">
       <property name="text"><string>Peindre</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="isolateButton">
       <property name="text"><string>Isoler</string></property>
       <property name="checkable"><bool>true</bool></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="orderLayout">
     <item>
      <widget class="QPushButton" name="forwardButton">
       <property name="text"><string>Monter</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="backwardButton">
       <property name="text"><string>Descendre</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="frontButton">
       <property name="text"><string>Devant</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="behindButton">
       <property name="text"><string>Derrière</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <!-- Réglages du plan sélectionné. Les champs numériques émettent sur editingFinished, jamais
        sur valueChanged : taper « 0.75 » empilerait sinon quatre pas d'annulation (leçon du
        LOT-67). -->
   <item>
    <widget class="QGroupBox" name="settingsGroup">
     <property name="title"><string>Plan sélectionné</string></property>
     <layout class="QFormLayout" name="settingsLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="densityLabel">
        <property name="text"><string>Densité (px/unité)</string></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="densityCombo"/>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="depthLabel">
        <property name="text"><string>Profondeur</string></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="depthCombo"/>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="parallaxXLabel">
        <property name="text"><string>Parallaxe X</string></property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="parallaxXSpin">
        <property name="minimum"><double>0.010000000000000</double></property>
        <property name="maximum"><double>4.000000000000000</double></property>
        <property name="singleStep"><double>0.050000000000000</double></property>
        <property name="decimals"><number>2</number></property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="parallaxYLabel">
        <property name="text"><string>Parallaxe Y</string></property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QDoubleSpinBox" name="parallaxYSpin">
        <property name="minimum"><double>0.010000000000000</double></property>
        <property name="maximum"><double>4.000000000000000</double></property>
        <property name="singleStep"><double>0.050000000000000</double></property>
        <property name="decimals"><number>2</number></property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="opacityLabel">
        <property name="text"><string>Opacité</string></property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QDoubleSpinBox" name="opacitySpin">
        <property name="minimum"><double>0.000000000000000</double></property>
        <property name="maximum"><double>1.000000000000000</double></property>
        <property name="singleStep"><double>0.050000000000000</double></property>
        <property name="decimals"><number>2</number></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <!-- Drapeau du NIVEAU, pas du plan : d'où son groupe distinct. Grisé en cadrage « niveau
        entier », où le moteur neutralise la parallaxe — sans quoi cocher la case ne produirait
        rien de visible, ce qui se lirait comme un défaut. -->
   <item>
    <widget class="QGroupBox" name="levelGroup">
     <property name="title"><string>Niveau</string></property>
     <layout class="QVBoxLayout" name="levelLayout">
      <item>
       <widget class="QCheckBox" name="parallaxCheck">
        <property name="text"><string>Parallaxe active</string></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="parallaxHint">
        <property name="text"><string>Sans effet en cadrage « niveau entier » : la caméra ne défile pas.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
