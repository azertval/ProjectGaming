            <item row="1" column="0"><widget class="QLabel" name="tournamentSizeLabel"><property name="text"><string>Taille du tournoi</string></property></widget></item>
            <item row="1" column="1">
             <widget class="QSpinBox" name="tournamentSizeSpin">
