<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AiModeScreen</class>
 <widget class="QWidget" name="AiModeScreen">
  <layout class="QVBoxLayout" name="outerLayout">
   <item>
    <layout class="QHBoxLayout" name="headerRow">
     <item>
      <widget class="QLabel" name="titleLabel">
       <property name="text"><string>Mode IA</string></property>
      </widget>
     </item>
     <item>
      <spacer name="headerSpacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
      </spacer>
     </item>
     <item>
      <widget class="hmi::PixelMenuButton" name="backButton">
       <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
       <property name="text"><string>Retour</string></property>
       <property name="flat"><bool>true</bool></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <!-- Cadre a bordure franche de l'identite pixel art (EX-IHM-070), comme l'ecran de
         pause et l'ecran de fin de niveau. -->
    <widget class="hmi::PixelFrameWidget" name="contentFrame">
     <layout class="QVBoxLayout" name="contentFrameLayout">
      <item>
    <widget class="QTabWidget" name="tabs">

     <!-- ===== Onglet Entrainement ===== -->
     <widget class="QWidget" name="trainingTab">
      <attribute name="title"><string>Entraînement</string></attribute>
      <layout class="QHBoxLayout" name="trainingLayout">
       <item>
        <!-- Colonne de reglages DEFILANTE, jamais posee a nu dans la fenetre.
             Sans elle, la hauteur minimale de cette colonne remonte jusqu'a la fenetre : vingt-six
             lignes de formulaire, multipliees par le facteur d'agrandissement des ecrans du jeu
             (jusqu'a 3x, `hmi::pixelArtScale`), imposaient une hauteur minimale de plus de deux
             mille pixels. Windows refusait alors de retailler la fenetre, qui debordait sous la
             barre des taches en rognant son contenu. Un ecran de l'application ne doit JAMAIS
             contraindre la taille de la fenetre : il s'y adapte, au besoin en defilant. -->
        <widget class="QScrollArea" name="trainingParamsScroll">
         <property name="widgetResizable"><bool>true</bool></property>
         <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
         <widget class="QWidget" name="trainingParamsContents">
        <layout class="QVBoxLayout" name="trainingParamsLayout">

         <item>
          <widget class="QGroupBox" name="commonGroup">
           <property name="title"><string>Commun</string></property>
           <layout class="QFormLayout" name="commonForm">
            <item row="0" column="0"><widget class="QLabel" name="levelLabel"><property name="text"><string>Niveau</string></property></widget></item>
            <item row="0" column="1"><widget class="QComboBox" name="levelCombo"/></item>

            <item row="1" column="0"><widget class="QLabel" name="algorithmLabel"><property name="text"><string>Algorithme</string></property></widget></item>
            <item row="1" column="1">
             <layout class="QHBoxLayout" name="algorithmRow">
              <item><widget class="QRadioButton" name="evolutionaryAlgorithmRadio"><property name="text"><string>Évolutif</string></property><property name="checked"><bool>true</bool></property></widget></item>
              <item><widget class="QRadioButton" name="reinforceAlgorithmRadio"><property name="text"><string>REINFORCE</string></property></widget></item>
              <item><widget class="QRadioButton" name="actorCriticAlgorithmRadio"><property name="text"><string>Acteur-critique</string></property></widget></item>
              <item><widget class="QRadioButton" name="advancedAlgorithmRadio"><property name="text"><string>DQN</string></property></widget></item>
             </layout>
            </item>

            <item row="2" column="0"><widget class="QLabel" name="seedLabel"><property name="text"><string>Graine</string></property></widget></item>
            <item row="2" column="1">
             <widget class="QSpinBox" name="seedSpin">
              <property name="minimum"><number>0</number></property>
              <property name="maximum"><number>2147483647</number></property>
              <property name="value"><number>42</number></property>
             </widget>
            </item>

            <item row="3" column="0"><widget class="QLabel" name="hiddenSizeLabel"><property name="text"><string>Taille de couche cachée</string></property></widget></item>
            <item row="3" column="1">
             <widget class="QSpinBox" name="hiddenSizeSpin">
              <property name="minimum"><number>4</number></property>
              <property name="maximum"><number>1024</number></property>
              <!-- Valeur de depart alignee sur training::evolutionary::DEFAULT_HIDDEN_SIZE : elle
                   est de toute facon ecrasee a l'ouverture par applyConfigToForm(TrainingConfig{}),
                   mais un ecart ici faisait changer le champ au premier clic sur « Reinitialiser
                   aux defauts ». -->
              <property name="value"><number>64</number></property>
             </widget>
            </item>

            <item row="5" column="0"><widget class="QLabel" name="maxStepsBudgetLabel"><property name="text"><string>Budget de pas</string></property></widget></item>
            <item row="5" column="1">
             <widget class="QSpinBox" name="stepBudgetSpin">
              <property name="minimum"><number>0</number></property>
              <property name="maximum"><number>1000000</number></property>
              <property name="value"><number>0</number></property>
              <property name="specialValueText"><string>Automatique</string></property>
             </widget>
            </item>

            <item row="6" column="0"><widget class="QLabel" name="stuckThresholdLabel"><property name="text"><string>Seuil de blocage</string></property></widget></item>
            <item row="6" column="1">
             <widget class="QSpinBox" name="stuckThresholdSpin">
              <property name="minimum"><number>0</number></property>
              <property name="maximum"><number>1000000</number></property>
              <property name="value"><number>0</number></property>
              <property name="specialValueText"><string>Automatique</string></property>
             </widget>
            </item>

            <item row="4" column="0"><widget class="QLabel" name="runsRootLabel"><property name="text"><string>Dossier des runs</string></property></widget></item>
            <item row="4" column="1">
             <layout class="QHBoxLayout" name="runsRootRow">
              <item><widget class="QLineEdit" name="runsRootEdit"/></item>
              <item><widget class="QPushButton" name="browseRunsRootButton"><property name="text"><string>Parcourir…</string></property></widget></item>
             </layout>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="evolutionaryGroup">
           <property name="title"><string>Évolutionniste</string></property>
           <layout class="QFormLayout" name="evolutionaryForm">
            <item row="0" column="0"><widget class="QLabel" name="populationLabel"><property name="text"><string>Taille de population</string></property></widget></item>
            <item row="0" column="1">
             <widget class="QSpinBox" name="populationSpin">
