            </item>

            <item row="4" column="0"><widget class="QLabel" name="maxGenerationsLabel"><property name="text"><string>Générations max</string></property></widget></item>
            <item row="4" column="1">
             <widget class="QSpinBox" name="maxGenerationsSpin">
