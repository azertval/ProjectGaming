<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AiModeScreen</class>
 <widget class="QWidget" name="AiModeScreen">
  <layout class="QVBoxLayout" name="outerLayout">
   <item>
    <layout class="QHBoxLayout" name="headerRow">
     <item>
      <widget class="QLabel" name="titleLabel">
       <property name="text"><string>Mode IA</string></property>
      </widget>
     </item>
     <item>
      <spacer name="headerSpacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
      </spacer>
     </item>
     <item>
      <widget class="hmi::PixelMenuButton" name="backButton">
       <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
       <property name="text"><string>Retour</string></property>
       <property name="flat"><bool>true</bool></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <!-- Cadre a bordure franche de l'identite pixel art (EX-IHM-070), comme l'ecran de
         pause et l'ecran de fin de niveau. -->
    <widget class="hmi::PixelFrameWidget" name="contentFrame">
     <layout class="QVBoxLayout" name="contentFrameLayout">
      <item>
    <widget class="QTabWidget" name="tabs">

     <!-- ===== Onglet Entrainement ===== -->
     <widget class="QWidget" name="trainingTab">
      <attribute name="title"><string>Entraînement</string></attribute>
      <layout class="QHBoxLayout" name="trainingLayout">
       <item>
        <layout class="QVBoxLayout" name="trainingParamsLayout">

         <item>
          <widget class="QGroupBox" name="commonGroup">
           <property name="title"><string>Commun</string></property>
           <layout class="QFormLayout" name="commonForm">
            <item row="0" column="0"><widget class="QLabel" name="levelLabel"><property name="text"><string>Niveau</string></property></widget></item>
            <item row="0" column="1"><widget class="QComboBox" name="levelCombo"/></item>

            <item row="1" column="0"><widget class="QLabel" name="algorithmLabel"><property name="text"><string>Algorithme</string></property></widget></item>
            <item row="1" column="1">
             <layout class="QHBoxLayout" name="algorithmRow">
              <item><widget class="QRadioButton" name="evolutionaryAlgorithmRadio"><property name="text"><string>Évolutif</string></property><property name="checked"><bool>true</bool></property></widget></item>
              <item><widget class="QRadioButton" name="reinforceAlgorithmRadio"><property name="text"><string>REINFORCE</string></property></widget></item>
              <item><widget class="QRadioButton" name="actorCriticAlgorithmRadio"><property name="text"><string>Acteur-critique</string></property></widget></item>
              <item><widget class="QRadioButton" name="advancedAlgorithmRadio"><property name="text"><string>DQN</string></property></widget></item>
             </layout>
            </item>

            <item row="2" column="0"><widget class="QLabel" name="seedLabel"><property name="text"><string>Graine</string></property></widget></item>
            <item row="2" column="1">
             <widget class="QSpinBox" name="seedSpin">
              <property name="minimum"><number>0</number></property>
              <property name="maximum"><number>2147483647</number></property>
              <property name="value"><number>42</number></property>
             </widget>
            </item>

            <item row="3" column="0" colspan="2">
             <widget class="QCheckBox" name="noStatsCheck">
              <property name="text"><string>Pas de trace CSV pour ce run</string></property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="evolutionaryGroup">
           <property name="title"><string>Évolutionniste</string></property>
           <layout class="QFormLayout" name="evolutionaryForm">
            <item row="0" column="0"><widget class="QLabel" name="populationLabel"><property name="text"><string>Taille de population</string></property></widget></item>
            <item row="0" column="1">
             <widget class="QSpinBox" name="populationSpin">
              <property name="minimum"><number>4</number></property>
              <property name="maximum"><number>2000</number></property>
              <property name="value"><number>64</number></property>
             </widget>
            </item>

            <item row="1" column="0"><widget class="QLabel" name="mutationRateLabel"><property name="text"><string>Taux de mutation</string></property></widget></item>
            <item row="1" column="1">
             <widget class="QDoubleSpinBox" name="mutationRateSpin">
              <property name="decimals"><number>3</number></property>
              <property name="singleStep"><double>0.010000000000000</double></property>
              <property name="minimum"><double>0.001000000000000</double></property>
              <property name="maximum"><double>1.000000000000000</double></property>
              <property name="value"><double>0.080000000000000</double></property>
             </widget>
            </item>

            <item row="2" column="0" colspan="2">
             <layout class="QHBoxLayout" name="stabilityRow">
              <item><widget class="QLabel" name="stabilityLabel"><property name="text"><string>Générations stables</string></property></widget></item>
              <item><widget class="QLabel" name="stabilityValue"><property name="text"><string>—</string></property></widget></item>
             </layout>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="gradientGroup">
           <property name="title"><string>Par gradient (REINFORCE / Acteur-critique / DQN)</string></property>
           <layout class="QFormLayout" name="gradientForm">
            <item row="0" column="0"><widget class="QLabel" name="episodesLabel"><property name="text"><string>Épisodes / générations max</string></property></widget></item>
            <item row="0" column="1">
             <widget class="QSpinBox" name="episodesSpin">
              <property name="minimum"><number>1</number></property>
              <property name="maximum"><number>100000</number></property>
              <property name="value"><number>300</number></property>
             </widget>
            </item>

            <item row="1" column="0"><widget class="QLabel" name="learningRateLabel"><property name="text"><string>Taux d'apprentissage</string></property></widget></item>
            <item row="1" column="1">
             <widget class="QDoubleSpinBox" name="learningRateSpin">
              <property name="decimals"><number>4</number></property>
              <property name="singleStep"><double>0.001000000000000</double></property>
              <property name="minimum"><double>0.000100000000000</double></property>
              <property name="maximum"><double>1.000000000000000</double></property>
              <property name="value"><double>0.010000000000000</double></property>
             </widget>
            </item>

            <item row="2" column="0"><widget class="QLabel" name="gammaLabel"><property name="text"><string>Gamma (actualisation)</string></property></widget></item>
            <item row="2" column="1">
             <widget class="QDoubleSpinBox" name="gammaSpin">
              <property name="decimals"><number>2</number></property>
              <property name="singleStep"><double>0.010000000000000</double></property>
              <property name="minimum"><double>0.000000000000000</double></property>
              <property name="maximum"><double>1.000000000000000</double></property>
              <property name="value"><double>0.990000000000000</double></property>
             </widget>
            </item>

            <item row="3" column="0"><widget class="QLabel" name="optimizerLabel"><property name="text"><string>Optimiseur</string></property></widget></item>
            <item row="3" column="1">
             <widget class="QComboBox" name="optimizerCombo">
              <item><property name="text"><string>sgd</string></property></item>
              <item><property name="text"><string>adam</string></property></item>
             </widget>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="dqnGroup">
           <property name="title"><string>DQN avancé</string></property>
           <layout class="QFormLayout" name="dqnForm">
            <item row="0" column="0"><widget class="QLabel" name="dqnReplayCapacityLabel"><property name="text"><string>Capacité de la mémoire de rejeu</string></property></widget></item>
            <item row="0" column="1">
             <widget class="QSpinBox" name="dqnReplayCapacitySpin">
              <property name="minimum"><number>100</number></property>
              <property name="maximum"><number>1000000</number></property>
              <property name="value"><number>2000</number></property>
             </widget>
            </item>

            <item row="1" column="0"><widget class="QLabel" name="dqnBatchSizeLabel"><property name="text"><string>Taille du mini-lot</string></property></widget></item>
            <item row="1" column="1">
             <widget class="QSpinBox" name="dqnBatchSizeSpin">
              <property name="minimum"><number>1</number></property>
              <property name="maximum"><number>4096</number></property>
              <property name="value"><number>32</number></property>
             </widget>
            </item>

            <item row="2" column="0"><widget class="QLabel" name="dqnWarmupSizeLabel"><property name="text"><string>Transitions avant la première mise à jour</string></property></widget></item>
            <item row="2" column="1">
             <widget class="QSpinBox" name="dqnWarmupSizeSpin">
              <property name="minimum"><number>1</number></property>
              <property name="maximum"><number>1000000</number></property>
              <property name="value"><number>32</number></property>
             </widget>
            </item>

            <item row="3" column="0"><widget class="QLabel" name="dqnUpdatePeriodLabel"><property name="text"><string>Période de mise à jour (pas)</string></property></widget></item>
            <item row="3" column="1">
             <widget class="QSpinBox" name="dqnUpdatePeriodSpin">
              <property name="minimum"><number>1</number></property>
              <property name="maximum"><number>10000</number></property>
              <property name="value"><number>1</number></property>
             </widget>
            </item>

            <item row="4" column="0"><widget class="QLabel" name="dqnTargetSyncPeriodLabel"><property name="text"><string>Période de synchro. du réseau cible (pas)</string></property></widget></item>
            <item row="4" column="1">
             <widget class="QSpinBox" name="dqnTargetSyncPeriodSpin">
              <property name="minimum"><number>1</number></property>
              <property name="maximum"><number>1000000</number></property>
              <property name="value"><number>200</number></property>
             </widget>
            </item>

            <item row="5" column="0"><widget class="QLabel" name="dqnEpsilonStartLabel"><property name="text"><string>Exploration initiale (epsilon)</string></property></widget></item>
            <item row="5" column="1">
             <widget class="QDoubleSpinBox" name="dqnEpsilonStartSpin">
              <property name="decimals"><number>2</number></property>
              <property name="singleStep"><double>0.050000000000000</double></property>
              <property name="minimum"><double>0.000000000000000</double></property>
              <property name="maximum"><double>1.000000000000000</double></property>
              <property name="value"><double>1.000000000000000</double></property>
             </widget>
            </item>

            <item row="6" column="0"><widget class="QLabel" name="dqnEpsilonEndLabel"><property name="text"><string>Exploration finale (epsilon)</string></property></widget></item>
            <item row="6" column="1">
             <widget class="QDoubleSpinBox" name="dqnEpsilonEndSpin">
              <property name="decimals"><number>2</number></property>
              <property name="singleStep"><double>0.050000000000000</double></property>
              <property name="minimum"><double>0.000000000000000</double></property>
              <property name="maximum"><double>1.000000000000000</double></property>
              <property name="value"><double>0.050000000000000</double></property>
             </widget>
            </item>

            <item row="7" column="0"><widget class="QLabel" name="dqnEpsilonDecayLabel"><property name="text"><string>Pas de décroissance de l'exploration</string></property></widget></item>
            <item row="7" column="1">
             <widget class="QSpinBox" name="dqnEpsilonDecaySpin">
              <property name="minimum"><number>1</number></property>
              <property name="maximum"><number>10000000</number></property>
              <property name="value"><number>2000</number></property>
             </widget>
            </item>

            <item row="8" column="0"><widget class="QLabel" name="dqnEpsilonCurrentLabel"><property name="text"><string>Epsilon courant</string></property></widget></item>
            <item row="8" column="1"><widget class="QLabel" name="dqnEpsilonCurrentValue"><property name="text"><string>—</string></property></widget></item>
           </layout>
          </widget>
         </item>

         <item>
          <layout class="QHBoxLayout" name="trainingButtonsRow">
           <item><widget class="QPushButton" name="launchTrainingButton"><property name="text"><string>Lancer l'entraînement</string></property></widget></item>
           <item><widget class="QPushButton" name="stopTrainingButton"><property name="text"><string>Arrêter l'entraînement</string></property><property name="visible"><bool>false</bool></property></widget></item>
          </layout>
         </item>
        </layout>
       </item>

       <item>
        <layout class="QVBoxLayout" name="trainingViewLayout">
         <item>
          <layout class="QHBoxLayout" name="trainingStatusRow">
           <item><widget class="QLabel" name="trainingStatusLabel"><property name="text"><string>Aucun entraînement en cours.</string></property></widget></item>
           <item>
            <spacer name="trainingStatusSpacer">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
            </spacer>
           </item>
           <item><widget class="QComboBox" name="generationCombo"><property name="enabled"><bool>false</bool></property></widget></item>
           <item><widget class="QPushButton" name="previewButton"><property name="text"><string>Voir en jeu</string></property><property name="enabled"><bool>false</bool></property></widget></item>
          </layout>
         </item>
         <item>
          <layout class="QHBoxLayout" name="trainingProgressRow">
           <item><widget class="QProgressBar" name="trainingProgressBar"><property name="value"><number>0</number></property></widget></item>
           <item><widget class="QLabel" name="trainingEtaLabel"><property name="text"><string/></property></widget></item>
          </layout>
         </item>
         <item>
          <widget class="hmi::TrainingChartWidget" name="trainingChart" native="true">
           <property name="minimumSize"><size><width>200</width><height>140</height></size></property>
          </widget>
         </item>
         <item>
          <widget class="QTableWidget" name="statsTable">
           <property name="columnCount"><number>4</number></property>
           <column><property name="text"><string>Génération</string></property></column>
           <column><property name="text"><string>Meilleure récompense</string></property></column>
           <column><property name="text"><string>Récompense moyenne</string></property></column>
           <column><property name="text"><string>Taux de réussite</string></property></column>
          </widget>
         </item>

         <item>
          <layout class="QHBoxLayout" name="trainingResultRow">
           <item><widget class="QLabel" name="trainingRunFolderValue"><property name="text"><string/></property></widget></item>
           <item><widget class="QPushButton" name="openRunFolderButton"><property name="text"><string>Ouvrir le dossier du run</string></property><property name="enabled"><bool>false</bool></property></widget></item>
          </layout>
         </item>
        </layout>
       </item>
      </layout>
     </widget>

     <!-- ===== Onglet Validation & sauvegarde ===== -->
     <widget class="QWidget" name="validateTab">
      <attribute name="title"><string>Validation &amp; sauvegarde</string></attribute>
      <layout class="QVBoxLayout" name="validateOuterLayout">
       <item>
        <layout class="QFormLayout" name="validateForm">
         <item row="0" column="0"><widget class="QLabel" name="runLabel"><property name="text"><string>Run</string></property></widget></item>
         <item row="0" column="1"><widget class="QComboBox" name="runCombo"/></item>

         <item row="1" column="0"><widget class="QLabel" name="repetitionsLabel"><property name="text"><string>Répétitions</string></property></widget></item>
         <item row="1" column="1">
          <widget class="QSpinBox" name="repetitionsSpin">
           <property name="minimum"><number>1</number></property>
           <property name="maximum"><number>1000</number></property>
           <property name="value"><number>30</number></property>
          </widget>
         </item>

         <item row="2" column="0" colspan="2"><widget class="QPushButton" name="evaluateButton"><property name="text"><string>Lancer l'évaluation</string></property></widget></item>
        </layout>
       </item>

       <item>
        <layout class="QFormLayout" name="resultsForm">
         <item row="0" column="0"><widget class="QLabel" name="successRateLabel"><property name="text"><string>Taux de réussite</string></property></widget></item>
         <item row="0" column="1"><widget class="QLabel" name="successRateValue"><property name="text"><string>—</string></property></widget></item>
         <item row="1" column="0"><widget class="QLabel" name="meanStepsLabel"><property name="text"><string>Pas moyen (réussis)</string></property></widget></item>
         <item row="1" column="1"><widget class="QLabel" name="meanStepsValue"><property name="text"><string>—</string></property></widget></item>
         <item row="2" column="0"><widget class="QLabel" name="varianceLabel"><property name="text"><string>Variance</string></property></widget></item>
         <item row="2" column="1"><widget class="QLabel" name="varianceValue"><property name="text"><string>—</string></property></widget></item>
        </layout>
       </item>

       <item>
        <layout class="QHBoxLayout" name="saveButtonsRow">
         <item><widget class="QPushButton" name="saveModelButton"><property name="text"><string>Sauvegarder le modèle</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         <item><widget class="QPushButton" name="exportReplayButton"><property name="text"><string>Exporter comme rejeu publié</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         <item><widget class="QLabel" name="saveStatusLabel"><property name="text"><string/></property></widget></item>
        </layout>
       </item>
       <item>
        <spacer name="validateSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- ===== Onglet Rejeu ===== -->
     <widget class="QWidget" name="replayTab">
      <attribute name="title"><string>Rejeu</string></attribute>
      <layout class="QVBoxLayout" name="replayOuterLayout">
       <item>
        <widget class="QTableWidget" name="replayTable">
         <property name="columnCount"><number>4</number></property>
         <column><property name="text"><string>Niveau</string></property></column>
         <column><property name="text"><string>Algorithme</string></property></column>
         <column><property name="text"><string>Récompense</string></property></column>
         <column><property name="text"><string>Exporté</string></property></column>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="replayButtonsRow">
         <item><widget class="QPushButton" name="launchReplayButton"><property name="text"><string>Lancer le rejeu</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         <item><widget class="QLabel" name="replayHintLabel"><property name="text"><string>Rejeux publiés (Elements/Replays), validés automatiquement avant lecture.</string></property></widget></item>
        </layout>
       </item>
      </layout>
     </widget>

    </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>hmi::PixelFrameWidget</class>
   <extends>QWidget</extends>
   <header>HMI/Interface/PixelFrameWidget.h</header>
   <container>1</container>
  </customwidget>
  <customwidget>
   <class>hmi::PixelMenuButton</class>
   <extends>QPushButton</extends>
   <header>HMI/Interface/PixelMenuButton.h</header>
  </customwidget>
  <customwidget>
   <class>hmi::TrainingChartWidget</class>
   <extends>QWidget</extends>
   <header>HMI/Interface/TrainingChartWidget.h</header>
   <container>1</container>
  </customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
