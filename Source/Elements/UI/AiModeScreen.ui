          <layout class="QHBoxLayout" name="trainingButtonsRow">
           <item><widget class="QPushButton" name="launchTrainingButton"><property name="text"><string>Lancer l'entraînement</string></property></widget></item>
           <item><widget class="QPushButton" name="stopTrainingButton"><property name="text"><string>Arrêter l'entraînement</string></property><property name="visible"><bool>false</bool></property></widget></item>
          </layout>
