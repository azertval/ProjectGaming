          <layout class="QHBoxLayout" name="trainingProgressRow">
           <item><widget class="QProgressBar" name="trainingProgressBar"><property name="value"><number>0</number></property></widget></item>
           <item><widget class="QLabel" name="trainingEtaLabel"><property name="text"><string/></property></widget></item>
          </layout>
         </item>
         <item>
          <widget class="hmi::TrainingChartWidget" name="trainingChart" native="true">
           <property name="minimumSize"><size><width>200</width><height>140</height></size></property>
          </widget>
         </item>
         <item>
          <widget class="QTableWidget" name="statsTable">
           <!-- Lecture seule : ces tableaux affichent un resultat de calcul, editer une
                cellule ne changerait que ce qui est dessine. -->
           <property name="editTriggers">
            <set>QAbstractItemView::NoEditTriggers</set>
           </property>
           <property name="selectionBehavior">
            <enum>QAbstractItemView::SelectRows</enum>
           </property>
           <property name="alternatingRowColors"><bool>true</bool></property>
           <property name="columnCount"><number>8</number></property>
           <column><property name="text"><string>Génération</string></property></column>
           <column><property name="text"><string>Meilleure récompense</string></property></column>
           <column><property name="text"><string>Récompense moyenne</string></property></column>
           <column><property name="text"><string>Pire récompense</string></property></column>
           <column><property name="text"><string>Écart-type</string></property></column>
           <column><property name="text"><string>Pas du meilleur</string></property></column>
           <column><property name="text"><string>Taux de réussite</string></property></column>
           <column><property name="text"><string>Graine</string></property></column>
          </widget>
         </item>

         <item>
          <layout class="QHBoxLayout" name="trainingResultRow">
           <item><widget class="QLabel" name="trainingRunFolderValue"><property name="text"><string/></property></widget></item>
           <item><widget class="QPushButton" name="openRunFolderButton"><property name="text"><string>Ouvrir le dossier du run</string></property><property name="enabled"><bool>false</bool></property></widget></item>
          </layout>
         </item>
        </layout>
       </item>
      </layout>
     </widget>

     <!-- ===== Onglet Validation & sauvegarde ===== -->
     <widget class="QWidget" name="validateTab">
      <attribute name="title"><string>Validation &amp; sauvegarde</string></attribute>
      <layout class="QVBoxLayout" name="validateTabLayout">
       <item>
        <!-- Meme raison que l'onglet Entrainement : cet onglet compte une quinzaine de lignes, et
             sa hauteur minimale remonterait de meme jusqu'a la fenetre. -->
        <widget class="QScrollArea" name="validateScroll">
         <property name="widgetResizable"><bool>true</bool></property>
         <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
         <widget class="QWidget" name="validateContents">
      <layout class="QVBoxLayout" name="validateOuterLayout">
       <item>
        <layout class="QFormLayout" name="validateForm">
         <item row="0" column="0"><widget class="QLabel" name="runLabel"><property name="text"><string>Run</string></property></widget></item>
         <item row="0" column="1"><widget class="QComboBox" name="runCombo"/></item>

         <item row="1" column="0"><widget class="QLabel" name="evalModelLabel"><property name="text"><string>Modèle</string></property></widget></item>
         <item row="1" column="1">
          <layout class="QHBoxLayout" name="evalModelRow">
           <item><widget class="QLineEdit" name="evalModelEdit"><property name="readOnly"><bool>true</bool></property></widget></item>
           <item><widget class="QPushButton" name="browseModelButton"><property name="text"><string>Parcourir…</string></property></widget></item>
          </layout>
         </item>

         <item row="2" column="0"><widget class="QLabel" name="evalLevelLabel"><property name="text"><string>Niveau</string></property></widget></item>
         <item row="2" column="1"><widget class="QComboBox" name="evalLevelCombo"/></item>

         <item row="3" column="0"><widget class="QLabel" name="repetitionsLabel"><property name="text"><string>Répétitions</string></property></widget></item>
         <item row="3" column="1">
          <widget class="QSpinBox" name="repetitionsSpin">
           <property name="minimum"><number>1</number></property>
           <property name="maximum"><number>1000</number></property>
           <property name="value"><number>30</number></property>
          </widget>
         </item>

         <item row="4" column="0"><widget class="QLabel" name="maxStepsLabel"><property name="text"><string>Budget de pas par épisode</string></property></widget></item>
         <item row="4" column="1">
          <widget class="QSpinBox" name="maxStepsSpin">
           <!-- Minimum a zero, qui vaut « derive du niveau » : un budget fixe plus court que celui
                de l'entrainement declare un modele incapable de terminer un niveau qu'il termine. -->
           <property name="minimum"><number>0</number></property>
           <property name="maximum"><number>1000000</number></property>
           <property name="value"><number>0</number></property>
           <property name="specialValueText"><string>Automatique</string></property>
          </widget>
         </item>

         <item row="5" column="0"><widget class="QLabel" name="evalSeedLabel"><property name="text"><string>Graine</string></property></widget></item>
         <item row="5" column="1">
          <widget class="QSpinBox" name="evalSeedSpin">
           <property name="minimum"><number>0</number></property>
           <property name="maximum"><number>2147483647</number></property>
           <property name="value"><number>0</number></property>
          </widget>
         </item>

         <item row="6" column="0"><widget class="QLabel" name="decodingLabel"><property name="text"><string>Mode de décodage</string></property></widget></item>
         <item row="6" column="1">
          <widget class="QComboBox" name="decodingCombo">
           <item><property name="text"><string>argmax</string></property></item>
           <item><property name="text"><string>stochastic</string></property></item>
          </widget>
         </item>

         <item row="7" column="0" colspan="2">
          <layout class="QHBoxLayout" name="evaluateButtonsRow">
           <item><widget class="QPushButton" name="evaluateButton"><property name="text"><string>Lancer l'évaluation</string></property></widget></item>
           <item><widget class="QPushButton" name="stopEvaluationButton"><property name="text"><string>Annuler l'évaluation</string></property><property name="visible"><bool>false</bool></property></widget></item>
          </layout>
         </item>

         <item row="8" column="0" colspan="2"><widget class="QProgressBar" name="evaluationProgressBar"><property name="value"><number>0</number></property></widget></item>
        </layout>
       </item>

       <item>
        <layout class="QFormLayout" name="resultsForm">
         <item row="0" column="0"><widget class="QLabel" name="successRateLabel"><property name="text"><string>Taux de réussite</string></property></widget></item>
         <item row="0" column="1"><widget class="QLabel" name="successRateValue"><property name="text"><string>—</string></property></widget></item>
         <item row="1" column="0"><widget class="QLabel" name="meanStepsLabel"><property name="text"><string>Pas moyen (réussis)</string></property></widget></item>
         <item row="1" column="1"><widget class="QLabel" name="meanStepsValue"><property name="text"><string>—</string></property></widget></item>
         <item row="2" column="0"><widget class="QLabel" name="meanStepsAllLabel"><property name="text"><string>Pas moyen (toutes)</string></property></widget></item>
         <item row="2" column="1"><widget class="QLabel" name="meanStepsAllValue"><property name="text"><string>—</string></property></widget></item>
         <item row="3" column="0"><widget class="QLabel" name="varianceLabel"><property name="text"><string>Variance</string></property></widget></item>
         <item row="3" column="1"><widget class="QLabel" name="varianceValue"><property name="text"><string>—</string></property></widget></item>
         <item row="4" column="0"><widget class="QLabel" name="repetitionsRunLabel"><property name="text"><string>Répétitions jouées</string></property></widget></item>
         <item row="4" column="1"><widget class="QLabel" name="repetitionsRunValue"><property name="text"><string>—</string></property></widget></item>
        </layout>
       </item>

       <item>
        <layout class="QHBoxLayout" name="saveButtonsRow">
         <item><widget class="QPushButton" name="saveModelButton"><property name="text"><string>Sauvegarder le modèle</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         <item><widget class="QPushButton" name="exportReplayButton"><property name="text"><string>Exporter comme rejeu publié</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         <item><widget class="QPushButton" name="exportReportButton"><property name="text"><string>Exporter le rapport CSV…</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         <item><widget class="QPushButton" name="reuseRunSettingsButton"><property name="text"><string>Reprendre les réglages de ce run</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         <item><widget class="QLabel" name="saveStatusLabel"><property name="text"><string/></property></widget></item>
        </layout>
       </item>
       <item>
        <spacer name="validateSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
        </spacer>
       </item>
      </layout>
         </widget>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- ===== Onglet Rejeu ===== -->
     <widget class="QWidget" name="replayTab">
      <attribute name="title"><string>Rejeu</string></attribute>
      <layout class="QVBoxLayout" name="replayOuterLayout">
       <item>
        <widget class="QTableWidget" name="replayTable">
           <!-- Lecture seule : ces tableaux affichent un resultat de calcul, editer une
                cellule ne changerait que ce qui est dessine. -->
           <property name="editTriggers">
            <set>QAbstractItemView::NoEditTriggers</set>
           </property>
           <property name="selectionBehavior">
            <enum>QAbstractItemView::SelectRows</enum>
           </property>
           <property name="alternatingRowColors"><bool>true</bool></property>
         <property name="columnCount"><number>4</number></property>
         <column><property name="text"><string>Niveau</string></property></column>
         <column><property name="text"><string>Algorithme</string></property></column>
         <column><property name="text"><string>Récompense</string></property></column>
         <column><property name="text"><string>Exporté</string></property></column>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="replayButtonsRow">
         <item><widget class="QPushButton" name="launchReplayButton"><property name="text"><string>Lancer le rejeu</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         <item><widget class="QLabel" name="replayHintLabel"><property name="text"><string>Rejeux publiés (Elements/Replays), validés automatiquement avant lecture.</string></property></widget></item>
        </layout>
       </item>
      </layout>
     </widget>

    </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
