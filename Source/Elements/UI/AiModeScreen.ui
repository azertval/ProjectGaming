<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AiModeScreen</class>
 <widget class="QWidget" name="AiModeScreen">
  <layout class="QVBoxLayout" name="outerLayout">
   <item>
    <layout class="QHBoxLayout" name="headerRow">
     <item>
      <widget class="QLabel" name="titleLabel">
       <property name="text"><string>Mode IA</string></property>
      </widget>
     </item>
     <item>
      <spacer name="headerSpacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
      </spacer>
     </item>
     <item>
      <widget class="hmi::PixelMenuButton" name="backButton">
       <property name="cursor"><cursorShape>PointingHandCursor</cursorShape></property>
       <property name="text"><string>Retour</string></property>
       <property name="flat"><bool>true</bool></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QTabWidget" name="tabs">

     <!-- ===== Onglet Entrainement ===== -->
     <widget class="QWidget" name="trainingTab">
      <attribute name="title"><string>Entraînement</string></attribute>
      <layout class="QHBoxLayout" name="trainingLayout">
       <item>
        <layout class="QFormLayout" name="trainingForm">
         <item row="0" column="0"><widget class="QLabel" name="levelLabel"><property name="text"><string>Niveau</string></property></widget></item>
         <item row="0" column="1"><widget class="QComboBox" name="levelCombo"/></item>

         <item row="1" column="0"><widget class="QLabel" name="algoLabel"><property name="text"><string>Algorithme</string></property></widget></item>
         <item row="1" column="1">
          <layout class="QHBoxLayout" name="algoRow">
           <item><widget class="QRadioButton" name="algoEvoRadio"><property name="text"><string>Évolutif</string></property><property name="checked"><bool>true</bool></property></widget></item>
           <item><widget class="QRadioButton" name="algoPgRadio"><property name="text"><string>REINFORCE</string></property></widget></item>
           <item><widget class="QRadioButton" name="algoAcRadio"><property name="text"><string>Acteur-critique</string></property></widget></item>
           <item><widget class="QRadioButton" name="algoAvanceRadio"><property name="text"><string>DQN</string></property></widget></item>
          </layout>
         </item>

         <item row="2" column="0"><widget class="QLabel" name="populationLabel"><property name="text"><string>Taille de population</string></property></widget></item>
         <item row="2" column="1">
          <widget class="QSpinBox" name="populationSpin">
           <property name="minimum"><number>4</number></property>
           <property name="maximum"><number>2000</number></property>
           <property name="value"><number>64</number></property>
          </widget>
         </item>

         <item row="3" column="0"><widget class="QLabel" name="mutationRateLabel"><property name="text"><string>Taux de mutation</string></property></widget></item>
         <item row="3" column="1">
          <widget class="QDoubleSpinBox" name="mutationRateSpin">
           <property name="decimals"><number>3</number></property>
           <property name="singleStep"><double>0.010000000000000</double></property>
           <property name="minimum"><double>0.001000000000000</double></property>
           <property name="maximum"><double>1.000000000000000</double></property>
           <property name="value"><double>0.080000000000000</double></property>
          </widget>
         </item>

         <item row="4" column="0"><widget class="QLabel" name="episodesLabel"><property name="text"><string>Épisodes / générations max</string></property></widget></item>
         <item row="4" column="1">
          <widget class="QSpinBox" name="episodesSpin">
           <property name="minimum"><number>1</number></property>
           <property name="maximum"><number>100000</number></property>
           <property name="value"><number>300</number></property>
          </widget>
         </item>

         <item row="5" column="0"><widget class="QLabel" name="learningRateLabel"><property name="text"><string>Taux d'apprentissage</string></property></widget></item>
         <item row="5" column="1">
          <widget class="QDoubleSpinBox" name="learningRateSpin">
           <property name="decimals"><number>4</number></property>
           <property name="singleStep"><double>0.001000000000000</double></property>
           <property name="minimum"><double>0.000100000000000</double></property>
           <property name="maximum"><double>1.000000000000000</double></property>
           <property name="value"><double>0.010000000000000</double></property>
          </widget>
         </item>

         <item row="6" column="0"><widget class="QLabel" name="gammaLabel"><property name="text"><string>Gamma (actualisation)</string></property></widget></item>
         <item row="6" column="1">
          <widget class="QDoubleSpinBox" name="gammaSpin">
           <property name="decimals"><number>2</number></property>
           <property name="singleStep"><double>0.010000000000000</double></property>
           <property name="minimum"><double>0.000000000000000</double></property>
           <property name="maximum"><double>1.000000000000000</double></property>
           <property name="value"><double>0.990000000000000</double></property>
          </widget>
         </item>

         <item row="7" column="0"><widget class="QLabel" name="optimizerLabel"><property name="text"><string>Optimiseur</string></property></widget></item>
         <item row="7" column="1">
          <widget class="QComboBox" name="optimizerCombo">
           <item><property name="text"><string>sgd</string></property></item>
           <item><property name="text"><string>adam</string></property></item>
          </widget>
         </item>

         <item row="8" column="0"><widget class="QLabel" name="seedLabel"><property name="text"><string>Graine</string></property></widget></item>
         <item row="8" column="1">
          <widget class="QSpinBox" name="seedSpin">
           <property name="minimum"><number>0</number></property>
           <property name="maximum"><number>2147483647</number></property>
           <property name="value"><number>42</number></property>
          </widget>
         </item>

         <item row="9" column="0" colspan="2">
          <layout class="QHBoxLayout" name="trainingButtonsRow">
           <item><widget class="QPushButton" name="launchTrainingButton"><property name="text"><string>Lancer l'entraînement</string></property></widget></item>
           <item><widget class="QPushButton" name="stopTrainingButton"><property name="text"><string>Arrêter l'entraînement</string></property><property name="visible"><bool>false</bool></property></widget></item>
          </layout>
         </item>
        </layout>
       </item>

       <item>
        <layout class="QVBoxLayout" name="trainingViewLayout">
         <item>
          <layout class="QHBoxLayout" name="trainingStatusRow">
           <item><widget class="QLabel" name="trainingStatusLabel"><property name="text"><string>Aucun entraînement en cours.</string></property></widget></item>
           <item>
            <spacer name="trainingStatusSpacer">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
            </spacer>
           </item>
           <item><widget class="QPushButton" name="previewButton"><property name="text"><string>Voir en jeu</string></property><property name="enabled"><bool>false</bool></property></widget></item>
          </layout>
         </item>
         <item>
          <widget class="QTableWidget" name="statsTable">
           <property name="columnCount"><number>4</number></property>
           <column><property name="text"><string>Génération</string></property></column>
           <column><property name="text"><string>Meilleure récompense</string></property></column>
           <column><property name="text"><string>Récompense moyenne</string></property></column>
           <column><property name="text"><string>Taux de réussite</string></property></column>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>

     <!-- ===== Onglet Validation & sauvegarde ===== -->
     <widget class="QWidget" name="validateTab">
      <attribute name="title"><string>Validation &amp; sauvegarde</string></attribute>
      <layout class="QVBoxLayout" name="validateOuterLayout">
       <item>
        <layout class="QFormLayout" name="validateForm">
         <item row="0" column="0"><widget class="QLabel" name="runLabel"><property name="text"><string>Run</string></property></widget></item>
         <item row="0" column="1"><widget class="QComboBox" name="runCombo"/></item>

         <item row="1" column="0"><widget class="QLabel" name="repetitionsLabel"><property name="text"><string>Répétitions</string></property></widget></item>
         <item row="1" column="1">
          <widget class="QSpinBox" name="repetitionsSpin">
           <property name="minimum"><number>1</number></property>
           <property name="maximum"><number>1000</number></property>
           <property name="value"><number>30</number></property>
          </widget>
         </item>

         <item row="2" column="0" colspan="2"><widget class="QPushButton" name="evaluateButton"><property name="text"><string>Lancer l'évaluation</string></property></widget></item>
        </layout>
       </item>

       <item>
        <layout class="QFormLayout" name="resultsForm">
         <item row="0" column="0"><widget class="QLabel" name="successRateLabel"><property name="text"><string>Taux de réussite</string></property></widget></item>
         <item row="0" column="1"><widget class="QLabel" name="successRateValue"><property name="text"><string>—</string></property></widget></item>
         <item row="1" column="0"><widget class="QLabel" name="meanStepsLabel"><property name="text"><string>Pas moyen (réussis)</string></property></widget></item>
         <item row="1" column="1"><widget class="QLabel" name="meanStepsValue"><property name="text"><string>—</string></property></widget></item>
         <item row="2" column="0"><widget class="QLabel" name="varianceLabel"><property name="text"><string>Variance</string></property></widget></item>
         <item row="2" column="1"><widget class="QLabel" name="varianceValue"><property name="text"><string>—</string></property></widget></item>
        </layout>
       </item>

       <item>
        <layout class="QHBoxLayout" name="saveButtonsRow">
         <item><widget class="QPushButton" name="saveModelButton"><property name="text"><string>Sauvegarder le modèle</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         <item><widget class="QPushButton" name="exportReplayButton"><property name="text"><string>Exporter comme rejeu publié</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         <item><widget class="QLabel" name="saveStatusLabel"><property name="text"><string/></property></widget></item>
        </layout>
       </item>
       <item>
        <spacer name="validateSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- ===== Onglet Rejeu ===== -->
     <widget class="QWidget" name="replayTab">
      <attribute name="title"><string>Rejeu</string></attribute>
      <layout class="QVBoxLayout" name="replayOuterLayout">
       <item>
        <widget class="QTableWidget" name="replayTable">
         <property name="columnCount"><number>4</number></property>
         <column><property name="text"><string>Niveau</string></property></column>
         <column><property name="text"><string>Algorithme</string></property></column>
         <column><property name="text"><string>Récompense</string></property></column>
         <column><property name="text"><string>Exporté</string></property></column>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="replayButtonsRow">
         <item><widget class="QPushButton" name="launchReplayButton"><property name="text"><string>Lancer le rejeu</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         <item><widget class="QLabel" name="replayHintLabel"><property name="text"><string>Rejeux publiés (Elements/Replays), validés automatiquement avant lecture.</string></property></widget></item>
        </layout>
       </item>
      </layout>
     </widget>

    </widget>
   </item>
  </layout>
 </widget>
