            </item>

            <item row="5" column="0"><widget class="QLabel" name="requiredSuccessesLabel"><property name="text"><string>Réussites stables exigées</string></property></widget></item>
            <item row="5" column="1">
             <widget class="QSpinBox" name="requiredSuccessesSpin">
