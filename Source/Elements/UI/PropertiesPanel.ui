<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>PropertiesPanel</class>
 <!-- Panneau « Propriétés » (LOT-67) : réglages de GAMEPLAY des éléments mobiles et du tableau.
      Volontairement séparé du panneau « Textures », qui porte l'habillage (skins, fond, cadrage) —
      y loger de la vitesse de plateforme ou un budget de sauts referait l'erreur que le LOT-57 a
      corrigée en sortant l'inspecteur des décors de ce même panneau.
      Les libellés posés ici sont des repères pour Qt Designer : retranslateUi les remplace tous
      (EX-REN-033). -->
 <widget class="QWidget" name="PropertiesPanel">
  <layout class="QVBoxLayout" name="verticalLayout">
   <!-- Élément sélectionné : une page par type d'élément paramétrable, plus une page d'attente.
        Piloté par la sélection de l'outil « Parcours » (hmi::PathSelection). -->
   <item>
    <widget class="QGroupBox" name="selectionGroup">
     <property name="title"><string>Élément sélectionné</string></property>
     <layout class="QVBoxLayout" name="selectionLayout">
      <item>
       <widget class="QStackedWidget" name="selectionStack">
        <property name="currentIndex"><number>0</number></property>
        <widget class="QWidget" name="emptyPage">
         <layout class="QVBoxLayout" name="emptyLayout">
          <item>
           <widget class="QLabel" name="emptyLabel">
            <property name="text"><string>Sélectionnez une plateforme mobile ou un piège avec l'outil Parcours.</string></property>
            <property name="wordWrap"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
        <widget class="QWidget" name="platformPage">
         <layout class="QFormLayout" name="platformLayout">
          <item row="0" column="0">
           <widget class="QLabel" name="platformSpeedLabel">
            <property name="text"><string>Vitesse (cases/s)</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QDoubleSpinBox" name="platformSpeedSpin">
            <property name="minimum"><double>0.000000000000000</double></property>
            <property name="maximum"><double>50.000000000000000</double></property>
            <property name="singleStep"><double>0.500000000000000</double></property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="platformPhaseLabel">
            <property name="text"><string>Déphasage (pas)</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="platformPhaseSpin">
            <property name="minimum"><number>-100000</number></property>
            <property name="maximum"><number>100000</number></property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="platformModeLabel">
            <property name="text"><string>Parcours</string></property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QComboBox" name="platformModeCombo"/>
          </item>
          <item row="3" column="0" colspan="2">
           <widget class="QLabel" name="platformWaypointsLabel">
            <property name="text"><string>Points : 0</string></property>
           </widget>
          </item>
         </layout>
        </widget>
        <widget class="QWidget" name="moverPage">
         <layout class="QFormLayout" name="moverLayout">
          <item row="0" column="0">
           <widget class="QLabel" name="moverAxisLabel">
            <property name="text"><string>Axe</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="moverAxisCombo"/>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="moverRangeLabel">
            <property name="text"><string>Portée (cases)</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="moverRangeSpin">
            <property name="minimum"><number>0</number></property>
            <property name="maximum"><number>1000</number></property>
           </widget>
          </item>
         </layout>
        </widget>
        <widget class="QWidget" name="blinkPage">
         <layout class="QFormLayout" name="blinkLayout">
          <item row="0" column="0">
           <widget class="QLabel" name="blinkPeriodLabel">
            <property name="text"><string>Période (pas)</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QSpinBox" name="blinkPeriodSpin">
            <property name="minimum"><number>1</number></property>
            <property name="maximum"><number>100000</number></property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="blinkPhaseLabel">
            <property name="text"><string>Déphasage (pas)</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="blinkPhaseSpin">
            <property name="minimum"><number>-100000</number></property>
            <property name="maximum"><number>100000</number></property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="blinkActiveLabel">
            <property name="text"><string>Durée active (pas)</string></property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QSpinBox" name="blinkActiveSpin">
            <property name="minimum"><number>0</number></property>
            <property name="maximum"><number>100000</number></property>
           </widget>
          </item>
         </layout>
        </widget>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <!-- Règles du tableau : DEUX notions distinctes, séparées en deux groupes explicitement
        libellés — un budget se consomme une fois pour toutes sur le tableau, une capacité se
        recharge à chaque atterrissage. Les confondre est l'erreur que ces libellés préviennent. -->
   <item>
    <widget class="QGroupBox" name="budgetGroup">
     <property name="title"><string>Budget du tableau (consommable, jamais rechargé)</string></property>
     <layout class="QFormLayout" name="budgetLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="jumpBudgetLabel">
        <property name="text"><string>Sauts</string></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QSpinBox" name="jumpBudgetSpin">
        <property name="minimum"><number>-1</number></property>
        <property name="maximum"><number>10000</number></property>
        <property name="specialValueText"><string>Illimité</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="dashBudgetLabel">
        <property name="text"><string>Dashs</string></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="dashBudgetSpin">
        <property name="minimum"><number>-1</number></property>
        <property name="maximum"><number>10000</number></property>
        <property name="specialValueText"><string>Illimité</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="capabilityGroup">
     <property name="title"><string>Capacités (rechargées à chaque atterrissage)</string></property>
     <layout class="QFormLayout" name="capabilityLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="airJumpsLabel">
        <property name="text"><string>Sauts aériens</string></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QSpinBox" name="airJumpsSpin">
        <property name="minimum"><number>-1</number></property>
        <property name="maximum"><number>100</number></property>
        <property name="specialValueText"><string>Par défaut</string></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="dashChargesLabel">
        <property name="text"><string>Charges de dash</string></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="dashChargesSpin">
        <property name="minimum"><number>-1</number></property>
        <property name="maximum"><number>100</number></property>
        <property name="specialValueText"><string>Par défaut</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="spacer">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
     <property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property>
    </spacer>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
