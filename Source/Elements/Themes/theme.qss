/* Modele de feuille de style Qt (LOT-56 TACHE-02) : produit au chargement par substitution de
   marqueurs (syntaxe dollar-accolade, cf. hmi::substituteStyleSheetTemplate -- non repetee ici en
   toutes lettres pour ne pas etre lue comme un marqueur reel par le scanner, non conscient des
   commentaires) avec les valeurs des jetons de design (HMI/Interface/DesignTokens.h). Aucune
   couleur litterale : chaque couleur passe par un marqueur.

   Deux portees, cf. epic.md :
   - identite du jeu (prefixe identity.color.*) : menu principal et ecran Options, portee par
     objectName (#MainMenu, #OptionsPage) -- INVARIANTE, jamais affectee par le theme de l'editeur.
   - chassis d'edition (prefixe editor.color.*) : tout le reste (fenetre, panneaux dockables,
     barres, arbres/tables/listes, controles, boites de dialogue) -- VARIABLE, second jeu de
     valeurs en TACHE-06 (theme clair). Le style Qt Fusion (ApplicationTheme::
     applyApplicationStyle) et la QPalette applicative (ApplicationTheme::buildApplicationPalette)
     couvrent deja la plupart des couleurs de base des controles standards ; cette feuille complete
     ce que la palette seule ne couvre pas (barres de titre de dock, onglets, en-tetes, infobulles,
     focus visible, separateurs).

   Marqueurs de grandeur (prefixe tokens.spacing.*) partages entre les deux portees (memes
   echelles). */

/* ===== Identite du jeu : les SIX ecrans joueur (INVARIANTE) =====

   Portee cadree par objectName, et rien d'autre : c'est ce cadrage, et lui seul, qui empeche la
   police pixel et les cadres a bordure franche de se repandre dans les tables et les arbres denses
   de l'editeur, ou ils seraient illisibles (LOT-68, EX-IHM-070).

   Toutes les grandeurs viennent des marqueurs identity.size.* / identity.space.* /
   identity.frame.thickness, DEJA MULTIPLIES par le facteur entier de hmi::pixelArtScale. Les
   marqueurs tokens.* de la section suivante ne sont jamais multiplies : le chassis d'edition est un
   outil de travail dont les tailles suivent les reglages du systeme, les ecrans du jeu sont une
   image agrandie.

   En pixels et jamais en points : un point vaut une fraction variable de pixel selon l'ecran, et le
   facteur entier n'aurait alors plus rien d'entier. Aucun border-radius nulle part : un coin
   arrondi produit un degrade d'anticrenelage que le filtrage au plus proche voisin ne rend pas. */

#MainMenu, #OptionsPage, #PauseScreen, #LevelSelectScreen, #LevelCompleteScreen, #CreditsScreen,
#AiModeScreen {
    background-color: ${identity.color.background};
    font-family: ${identity.font.body};
    font-size: ${identity.size.body}px;
    color: ${identity.color.text};
}

/* Recouvrements (pause, fin de niveau) : fond translucide pose en code, pas ici -- la couleur de
   fond opaque ci-dessus les rendrait opaques et cacherait la scene figee derriere. */
#PauseScreen, #LevelCompleteScreen {
    background-color: transparent;
}

/* ---- Titres d'ecran : seconde famille, tres typee, reservee a ce seul usage ---- */
#MainMenu QLabel#menuTitle,
#OptionsPage QLabel#optionsTitle,
#PauseScreen QLabel#pauseTitle,
#LevelSelectScreen QLabel#titleLabel,
#LevelCompleteScreen QLabel#titleLabel,
#CreditsScreen QLabel#creditsTitle,
#AiModeScreen QLabel#titleLabel {
    color: ${identity.color.accent};
    font-family: ${identity.font.title};
    font-size: ${identity.size.screenTitle}px;
    font-weight: bold;
}

/* ---- Cartes des recouvrements : cadre pixel, contour puis biseaux ----
   Les coins ne sont pas entailles ici (une feuille de style ne sait pas les evider) : les cadres a
   coins entailles sont peints par hmi::PixelFrameWidget, promu dans les .ui. Cette regle habille
   les conteneurs ordinaires qui n'ont pas besoin d'un cadre a part entiere. */
#PauseScreen QWidget#menuCard,
#LevelCompleteScreen QWidget#menuCard {
    background-color: ${identity.color.surface};
    border: ${identity.frame.thickness}px solid ${identity.color.outline};
    border-top-color: ${identity.color.bevelLight};
    border-left-color: ${identity.color.bevelLight};
    border-bottom-color: ${identity.color.bevelDark};
    border-right-color: ${identity.color.bevelDark};
    padding: ${identity.space.extraLarge}px;
}

/* ---- Entrees de menu ----
   La marque de focus est le CURSEUR peint par hmi::PixelMenuButton, pas cette teinte : une feuille
   de style ne peut pas ajouter de contenu, et la couleur seule est insuffisante a la manette. */
#MainMenu QPushButton,
#PauseScreen QPushButton,
#LevelCompleteScreen QPushButton,
#LevelSelectScreen QPushButton,
#CreditsScreen QPushButton {
    color: ${identity.color.textMuted};
    background: transparent;
    border: none;
    border-radius: 0;
    text-align: left;
    padding: ${identity.space.small}px ${identity.space.medium}px;
    font-size: ${identity.size.sectionTitle}px;
    font-weight: bold;
}
#MainMenu QPushButton:hover, #MainMenu QPushButton:focus,
#PauseScreen QPushButton:hover, #PauseScreen QPushButton:focus,
#LevelCompleteScreen QPushButton:hover, #LevelCompleteScreen QPushButton:focus,
#LevelSelectScreen QPushButton:hover, #LevelSelectScreen QPushButton:focus,
#CreditsScreen QPushButton:hover, #CreditsScreen QPushButton:focus {
    color: ${identity.color.accent};
}
#MainMenu QPushButton:disabled,
#PauseScreen QPushButton:disabled,
#LevelCompleteScreen QPushButton:disabled {
    color: ${identity.color.border};
}

/* ---- Listes de niveaux ---- */
#LevelSelectScreen QListWidget {
    background: ${identity.color.surface};
    border: ${identity.frame.thickness}px solid ${identity.color.outline};
    border-radius: 0;
    font-size: ${identity.size.sectionTitle}px;
    outline: none;
}
#LevelSelectScreen QListWidget::item {
    padding: ${identity.space.small}px ${identity.space.medium}px;
    color: ${identity.color.textMuted};
}
#LevelSelectScreen QListWidget::item:selected,
#LevelSelectScreen QListWidget::item:hover {
    color: ${identity.color.accent};
    background: ${identity.color.surfaceAlt};
}

/* Bilan de fin de tableau : taille de LEGENDE, en retrait. Il informe apres coup, il ne doit ni
   concurrencer le titre ni elargir la carte -- les deux recouvrements (pause, fin de niveau)
   doivent occuper la meme place. */
#LevelCompleteScreen QLabel#summaryLabel {
    color: ${identity.color.textMuted};
    font-size: ${identity.size.caption}px;
    padding: ${identity.space.small}px 0;
}

/* ---- Credits : hierarchie en-tete / nom / licence ---- */
#CreditsScreen QLabel#developmentLabel,
#CreditsScreen QLabel#audioLabel,
#CreditsScreen QLabel#graphicsLabel {
    color: ${identity.color.accent};
    font-size: ${identity.size.body}px;
    font-weight: bold;
}
#CreditsScreen QLabel#audioCredit,
#CreditsScreen QLabel#graphicsCredit {
    color: ${identity.color.textMuted};
    font-size: ${identity.size.caption}px;
}

/* ---- Onglets ---- */
#OptionsPage QTabWidget::pane,
#LevelSelectScreen QTabWidget::pane,
#AiModeScreen QTabWidget::pane {
    border: ${identity.frame.thickness}px solid ${identity.color.outline};
    background: ${identity.color.surface};
    border-radius: 0;
}
#OptionsPage QTabBar::tab,
#LevelSelectScreen QTabBar::tab,
#AiModeScreen QTabBar::tab {
    background: ${identity.color.surfaceAlt};
    color: ${identity.color.textMuted};
    border: ${identity.frame.thickness}px solid ${identity.color.outline};
    border-bottom: none;
    border-radius: 0;
    padding: ${identity.space.small}px ${identity.space.large}px;
    font-size: ${identity.size.body}px;
    font-weight: bold;
}
#OptionsPage QTabBar::tab:selected,
#LevelSelectScreen QTabBar::tab:selected,
#AiModeScreen QTabBar::tab:selected {
    color: ${identity.color.background};
    background: ${identity.color.accent};
}

/* ---- Controles de l'ecran Options et de Mode IA (LOT-ANNEXE-21) ---- */
#OptionsPage QLabel,
#OptionsPage QCheckBox,
#OptionsPage QComboBox,
#AiModeScreen QLabel,
#AiModeScreen QCheckBox,
#AiModeScreen QComboBox,
#AiModeScreen QRadioButton,
#AiModeScreen QSpinBox,
#AiModeScreen QDoubleSpinBox {
    color: ${identity.color.text};
    font-size: ${identity.size.body}px;
}
#AiModeScreen QComboBox,
#AiModeScreen QSpinBox,
#AiModeScreen QDoubleSpinBox {
    background: ${identity.color.surfaceAlt};
    border: ${identity.frame.thickness}px solid ${identity.color.outline};
    border-radius: 0;
    padding: ${identity.space.small}px ${identity.space.medium}px;
}
#AiModeScreen QTableWidget {
    background: ${identity.color.surface};
    alternate-background-color: ${identity.color.surfaceAlt};
    color: ${identity.color.text};
    border: ${identity.frame.thickness}px solid ${identity.color.outline};
    gridline-color: ${identity.color.border};
    selection-background-color: ${identity.color.accent};
    selection-color: ${identity.color.background};
}
#AiModeScreen QHeaderView::section {
    background: ${identity.color.surfaceAlt};
    color: ${identity.color.textMuted};
    border: none;
    border-right: ${identity.frame.thickness}px solid ${identity.color.outline};
    border-bottom: ${identity.frame.thickness}px solid ${identity.color.outline};
    padding: ${identity.space.small}px;
}
#OptionsPage QCheckBox::indicator {
    width: ${identity.size.body}px;
    height: ${identity.size.body}px;
    border: ${identity.frame.thickness}px solid ${identity.color.outline};
    background: ${identity.color.surfaceAlt};
    border-radius: 0;
}
#OptionsPage QCheckBox::indicator:checked {
    background: ${identity.color.accent};
}
#OptionsPage QComboBox {
    background: ${identity.color.surfaceAlt};
    border: ${identity.frame.thickness}px solid ${identity.color.outline};
    border-radius: 0;
    padding: ${identity.space.small}px ${identity.space.medium}px;
}
#OptionsPage QSlider::groove:horizontal {
    background: ${identity.color.surfaceAlt};
    border: ${identity.frame.thickness}px solid ${identity.color.outline};
    height: ${identity.space.medium}px;
}
#OptionsPage QSlider::sub-page:horizontal {
    background: ${identity.color.accent};
}
#OptionsPage QSlider::handle:horizontal {
    background: ${identity.color.text};
    border: ${identity.frame.thickness}px solid ${identity.color.outline};
    width: ${identity.space.medium}px;
    margin: -${identity.space.small}px 0;
}
#OptionsPage QPushButton,
#AiModeScreen QPushButton {
    color: ${identity.color.background};
    background: ${identity.color.accent};
    border: ${identity.frame.thickness}px solid ${identity.color.outline};
    border-radius: 0;
    text-align: center;
    padding: ${identity.space.small}px ${identity.space.large}px;
    font-size: ${identity.size.body}px;
}
#OptionsPage QPushButton:hover,
#OptionsPage QPushButton:focus,
#AiModeScreen QPushButton:hover,
#AiModeScreen QPushButton:focus {
    background: ${identity.color.accentHover};
}
#OptionsPage QPushButton:disabled,
#AiModeScreen QPushButton:disabled {
    background: ${identity.color.surfaceAlt};
    color: ${identity.color.textMuted};
    border-color: ${identity.color.border};
}

/* Retour de l'ecran Options/Mode IA : c'est une ENTREE DE MENU, pas une commande — elle doit se
   lire comme celles du menu principal, pas comme un bouton plein d'action juste au-dessus.
   Le selecteur vise la classe promue : Qt remplace "::" par "--" dans le nom de type QSS, et cette
   regle l'emporte sur la precedente parce qu'elle est plus specifique. */
#OptionsPage hmi--PixelMenuButton,
#AiModeScreen hmi--PixelMenuButton {
    color: ${identity.color.textMuted};
    background: transparent;
    border: none;
    text-align: left;
    padding: ${identity.space.small}px ${identity.space.medium}px;
    font-size: ${identity.size.sectionTitle}px;
    font-weight: bold;
}
#OptionsPage hmi--PixelMenuButton:hover,
#OptionsPage hmi--PixelMenuButton:focus,
#AiModeScreen hmi--PixelMenuButton:hover,
#AiModeScreen hmi--PixelMenuButton:focus {
    color: ${identity.color.accent};
    background: transparent;
}

/* ===== Chassis d'edition : tout le reste (VARIABLE) ===== */

/* Panneaux dockables : barre de titre et bordure -- QPalette ne porte pas ces roles. */
QDockWidget {
    color: ${editor.color.text};
    border: 1px solid ${editor.color.border};
}
QDockWidget::title {
    background: ${editor.color.surfaceAlt};
    padding: ${tokens.spacing.small}px ${tokens.spacing.medium}px;
    border-bottom: 1px solid ${editor.color.border};
}

/* Barre de menus et menus. */
QMenuBar {
    background: ${editor.color.surface};
    color: ${editor.color.text};
    border-bottom: 1px solid ${editor.color.border};
}
QMenuBar::item:selected {
    background: ${editor.color.surfaceAlt};
    color: ${editor.color.accent};
}
QMenu {
    background: ${editor.color.surface};
    color: ${editor.color.text};
    border: 1px solid ${editor.color.border};
}
QMenu::item:selected {
    background: ${editor.color.surfaceAlt};
    color: ${editor.color.accent};
}
QMenu::separator {
    height: 1px;
    background: ${editor.color.border};
    margin: ${tokens.spacing.extraSmall}px ${tokens.spacing.small}px;
}

/* Barre d'outils (TACHE-04) et barre d'etat. */
QToolBar {
    background: ${editor.color.surface};
    border-bottom: 1px solid ${editor.color.border};
    spacing: ${tokens.spacing.extraSmall}px;
    padding: ${tokens.spacing.extraSmall}px;
}
QStatusBar {
    background: ${editor.color.surface};
    color: ${editor.color.textMuted};
    border-top: 1px solid ${editor.color.border};
}

/* Onglets (panneau Textures). */
QTabWidget::pane {
    border: 1px solid ${editor.color.border};
    background: ${editor.color.background};
}
QTabBar::tab {
    background: ${editor.color.surfaceAlt};
    color: ${editor.color.textMuted};
    padding: ${tokens.spacing.small}px ${tokens.spacing.medium}px;
    border: 1px solid ${editor.color.border};
    border-bottom: none;
}
QTabBar::tab:selected {
    background: ${editor.color.background};
    color: ${editor.color.text};
}
QTabBar::tab:focus {
    border-color: ${editor.color.accent};
}

/* Arbres, tables et listes : en-tetes, lignes alternees, survol, selection. */
QTreeView, QTableView, QListView {
    background: ${editor.color.background};
    alternate-background-color: ${editor.color.surfaceAlt};
    color: ${editor.color.text};
    border: 1px solid ${editor.color.border};
    selection-background-color: ${editor.color.accent};
    selection-color: ${editor.color.background};
}
QTreeView::item:hover, QTableView::item:hover, QListView::item:hover {
    background: ${editor.color.surfaceAlt};
}
QHeaderView::section {
    background: ${editor.color.surface};
    color: ${editor.color.textMuted};
    padding: ${tokens.spacing.extraSmall}px ${tokens.spacing.small}px;
    border: none;
    border-right: 1px solid ${editor.color.border};
    border-bottom: 1px solid ${editor.color.border};
}

/* Champs de saisie, compteurs numeriques, listes deroulantes -- focus visible (EX-IHM-040). */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: ${editor.color.surface};
    color: ${editor.color.text};
    border: 1px solid ${editor.color.border};
    border-radius: 3px;
    padding: ${tokens.spacing.extraSmall}px ${tokens.spacing.small}px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 2px solid ${editor.color.accent};
}
QComboBox QAbstractItemView {
    background: ${editor.color.surface};
    color: ${editor.color.text};
    selection-background-color: ${editor.color.accent};
    selection-color: ${editor.color.background};
    border: 1px solid ${editor.color.border};
}

/* Boutons, cases a cocher, boutons radio -- focus visible. */
QPushButton {
    background: ${editor.color.surface};
    color: ${editor.color.text};
    border: 1px solid ${editor.color.border};
    border-radius: 3px;
    padding: ${tokens.spacing.extraSmall}px ${tokens.spacing.large}px;
}
QPushButton:hover {
    border-color: ${editor.color.accentHover};
}
QPushButton:pressed {
    background: ${editor.color.surfaceAlt};
}
QPushButton:focus {
    border: 2px solid ${editor.color.accent};
}
QPushButton:disabled {
    color: ${editor.color.textMuted};
}
QCheckBox:focus, QRadioButton:focus {
    border: 1px solid ${editor.color.accent};
}

/* Barres de defilement. */
QScrollBar:vertical, QScrollBar:horizontal {
    background: ${editor.color.background};
    border: none;
}
QScrollBar::handle {
    background: ${editor.color.surfaceAlt};
    border-radius: 3px;
}
QScrollBar::handle:hover {
    background: ${editor.color.border};
}
QScrollBar::add-line, QScrollBar::sub-line {
    background: transparent;
    border: none;
}

/* Infobulles et separateurs. */
QToolTip {
    background: ${editor.color.surfaceAlt};
    color: ${editor.color.text};
    border: 1px solid ${editor.color.border};
    padding: ${tokens.spacing.extraSmall}px ${tokens.spacing.small}px;
}
QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: ${editor.color.border};
}

/* Boites de dialogue standard (message, fichier, saisie) et dialogue de redimensionnement
   (MainWindow::openResizeDialog) : QDialog n'a pas de role de palette dedie, sa QPalette::Window
   couvre deja le fond -- seule la bordure des boutons/champs ci-dessus s'applique en plus. */
QDialog {
    background: ${editor.color.background};
    color: ${editor.color.text};
}
