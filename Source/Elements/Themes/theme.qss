/* Thème de l'IHM Qt (menu / options), repris de l'ancien menu « maison » : fond sombre, titres
   quasi-blancs, accents ambre. Externalisé (éditable hors code) et embarqué via resources.qrc.
   Portée par objectName pour ne pas restyler l'éditeur (docks) qui garde le thème par défaut. */

#MainMenu, #OptionsPage {
    background-color: #1a1f29;
}

#MainMenu QLabel#menuTitle,
#OptionsPage QLabel#optionsTitle {
    color: #f2f2ff;
}

/* Menu principal : options en liste à gauche, gris-bleu, ambre au survol/focus. */
#MainMenu QPushButton {
    color: #b3b8c7;
    background: transparent;
    border: none;
    text-align: left;
    padding: 8px 0;
    font-family: "Consolas";
    font-size: 22px;
    font-weight: bold;
}
#MainMenu QPushButton:hover,
#MainMenu QPushButton:focus {
    color: #ffd133;
}

/* Page Options : onglets sombres, accent ambre sur l'onglet actif. */
#OptionsPage QTabWidget::pane {
    border: 1px solid #333a48;
    background: #1e2531;
}
#OptionsPage QTabBar::tab {
    background: #232a36;
    color: #b3b8c7;
    padding: 8px 18px;
}
#OptionsPage QTabBar::tab:selected {
    color: #ffd133;
    background: #1e2531;
}
#OptionsPage QLabel,
#OptionsPage QCheckBox,
#OptionsPage QComboBox {
    color: #cfd3dc;
}
#OptionsPage QPushButton {
    color: #b3b8c7;
    background: transparent;
    border: 1px solid #333a48;
    border-radius: 3px;
    padding: 6px 16px;
}
#OptionsPage QPushButton:hover,
#OptionsPage QPushButton:focus {
    color: #ffd133;
    border-color: #ffd133;
}
