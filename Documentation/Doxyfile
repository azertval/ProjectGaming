# Doxyfile minimal — ProjectGaming
# Génération : depuis Documentation/, exécuter `doxygen Doxyfile`.
# Les options non spécifiées gardent les valeurs par défaut de Doxygen.

PROJECT_NAME           = "ProjectGaming"
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "Jeu 2D de plateforme/puzzle en C++/DirectX"

OUTPUT_DIRECTORY       = generated
CREATE_SUBDIRS         = NO

# Entrées : tout le code source.
INPUT                  = ../Source
RECURSIVE              = YES
FILE_PATTERNS          = *.cpp *.h *.hpp
EXCLUDE_PATTERNS       = */build/* */External/*

# Extraction.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
BUILTIN_STL_SUPPORT    = YES
OPTIMIZE_OUTPUT_FOR_C  = NO

# Sorties.
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

# Verbosité.
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
