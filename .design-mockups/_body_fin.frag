<div class="screen" style="--accent: {{accent}}">
  <!-- Meme patron de recouvrement que Pause : la scene reste visible derriere. -->
  <div style="position: absolute; inset: 0; background: #1b2432;"></div>
  <div class="grid-bg"></div>
  <div style="position: absolute; left: 0; right: 0; bottom: 0; height: 160px; background: #2a3547;"></div>
  <div style="position: absolute; left: 992px; bottom: 160px; width: 64px; height: 96px; background: #7ee06a;"></div>
  <div style="position: absolute; left: 1024px; bottom: 256px; width: 4px; height: 64px; background: #3d4a5e;"></div>
  <div style="position: absolute; inset: 0; background: rgba(10,13,19,.72);"></div>

  <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;">
    <div class="frame frame--accent" style="width: 620px; padding: 44px 0 36px;">
      <div class="title" style="font-size: 22px; text-align: center; line-height: 1.7;">TABLEAU TERMINÉ<br><span style="font-size: 15px; color: #f2f2ff;">03 — Interrupteurs</span></div>

      <div style="height: 32px;"></div>
      <!-- Bilan du tableau : trois chiffres, pas un de plus. -->
      <div style="display: flex; justify-content: center; gap: 48px; font-size: 20px;">
        <div style="text-align: center;"><div style="color: var(--dim); font-size: 16px; letter-spacing: 1px;">TEMPS</div><div style="color: #f2f2ff; padding-top: 6px;">01:42</div></div>
        <div style="text-align: center;"><div style="color: var(--dim); font-size: 16px; letter-spacing: 1px;">MORTS</div><div style="color: #f2f2ff; padding-top: 6px;">3</div></div>
        <div style="text-align: center;"><div style="color: var(--dim); font-size: 16px; letter-spacing: 1px;">SAUTS</div><div style="color: #f2f2ff; padding-top: 6px;">128</div></div>
      </div>

      <div style="height: 34px;"></div>
      <div style="display: flex; flex-direction: column;">
        <div class="row row--focus" style="padding-left: 68px;">@CARET@<span>Continuer</span></div>
        <div class="row" style="padding-left: 68px;">@CARET@<span>Rejouer</span></div>
        <div class="row" style="padding-left: 68px;">@CARET@<span>Retour au menu</span></div>
      </div>
    </div>
  </div>
</div>
